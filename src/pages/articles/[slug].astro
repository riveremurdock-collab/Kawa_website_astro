---
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostLayout from '../../layouts/PostLayout.astro';
import { getCollection } from 'astro:content';

// Derive URL slug from glob loader entry.id (e.g. "piolet-bike-check/index.mdx" → "piolet-bike-check")
const toSlug = (id: string) => id.replace(/\/index\.mdx$/, '').replace(/\.mdx$/, '');

export async function getStaticPaths() {
    const toSlug = (id: string) => id.replace(/\/index\.mdx$/, '').replace(/\.mdx$/, '');
    // Every article gets a page, including drafts — same as portfolio.
    // Drafts are just excluded from the sidebar list below.
    const allEntries = await getCollection('articles');
    return allEntries.map(entry => ({
        params: { slug: toSlug(entry.id) },
        props: { entry },
    }));
}

const { entry } = Astro.props;

const publishedEntries = await getCollection('articles', ({ data }) => !data.draft);
const sortedArticles = publishedEntries
    .map(e => ({ slug: toSlug(e.id), data: e.data }))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const currentSlug = toSlug(entry.id);
---

<BlogLayout
    title={`${entry.data.title} | Kawa Designs`}
    description={entry.data.excerpt}
    articles={sortedArticles}
    currentSlug={currentSlug}
>
    <PostLayout entry={entry}>
        <div class="article-tags" slot="meta">
            {entry.data.tags.map(tag => (
                <span class="tag">{tag}</span>
            ))}
        </div>
    </PostLayout>

    <div class="comments-section">
        <h2>Comments</h2>
        <div id="cusdis_thread"
            data-host="https://cusdis.com"
            data-app-id="e5efd1f2-ea0a-4da1-b432-df5979658893"
            data-page-id={currentSlug}
            data-page-url={Astro.url.href}
            data-page-title={entry.data.title}
        ></div>
        <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
    </div>
</BlogLayout>
