---
import InnerPageLayout from '../layouts/InnerPageLayout.astro';
---

<InnerPageLayout title="Photo Inker | Kawa Designs" description="Turn any photo into a risograph-style print, or into print-ready riso layers, with the Kawa Designs Photo Inker">
    <div class="page-content-box inker-box">
        <h1 class="visually-hidden">Photo Inker</h1>
        <div class="inker-wrapper">
            <!-- Built from the separate Photo Inker project with `npm run build:site`. -->
            <iframe
                src="/photo-inker-app/index.html"
                title="Photo Inker"
                loading="lazy"
            ></iframe>
        </div>
    </div>
</InnerPageLayout>

<style>
    /* The tool is the whole page: no padding, so it fills the box edge to edge. */
    .inker-box {
        padding: 0;
        overflow: hidden;
    }

    /* Kept for screen readers and search engines; the tool itself is the visible content. */
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Fills the box's full height in the flex column, giving the iframe a defined container */
    .inker-wrapper {
        background: white;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .inker-wrapper iframe {
        width: 100%;
        height: 100%;
        flex: 1;
        min-height: 0;
        display: block;
        border: none;
    }

    /* The tool needs more room than a phone's leftover height gives it, so
       on small screens the box scrolls and the tool keeps a usable height. */
    @media (max-width: 768px) {
        .inker-box {
            overflow-y: auto;
        }

        .inker-wrapper {
            flex: none;
            height: 760px;
        }
    }
</style>
