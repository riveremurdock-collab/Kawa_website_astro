---
import InnerPageLayout from '../layouts/InnerPageLayout.astro';
---

<InnerPageLayout app customCursor={false} title="Photo Inker | Kawa Designs" description="Turn any photo into a risograph-style print, or into print-ready riso layers, with the Kawa Designs Photo Inker">
    <div class="page-content-box inker-box">
        <h1 class="visually-hidden">Photo Inker</h1>
        <div class="inker-wrapper">
            <!-- Built from the separate Photo Inker project with `npm run build:site`. -->
            <iframe
                src="/photo-inker-app/index.html"
                title="Photo Inker"
                loading="lazy"
            ></iframe>
        </div>
    </div>
</InnerPageLayout>

<style>
    /* The tool fills the window below the nav bar (the layout's app mode). */
    .inker-box {
        overflow: hidden;
    }

    /* Kept for screen readers and search engines; the tool itself is the visible content. */
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* Fills the box's full height in the flex column, giving the iframe a defined container */
    .inker-wrapper {
        background: white;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .inker-wrapper iframe {
        width: 100%;
        height: 100%;
        flex: 1;
        min-height: 0;
        display: block;
        border: none;
    }
</style>
