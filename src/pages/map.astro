---
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import Header from '../components/Header.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Interactive route maps for Kawa Designs adventures" />
    <title>Route Maps | Kawa Designs</title>
    <link rel="icon" type="image/png" href="/images/logos/kawa favicon.png" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <link rel="stylesheet" href="/styles/map.css" />
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        /* Header floats above the map — padding matches .inner-shell */
        .map-header-wrap {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1001;
            padding: 28px;
        }

        #overview-map-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
    </style>
</head>
<body>
    <div class="map-header-wrap">
        <Header />
    </div>

    <div id="overview-map-container" role="application" aria-label="Interactive route map"></div>

    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script is:inline src="/scripts/overview-map.js"></script>
    <script is:inline>
        function initMap() {
            if (window.OverviewMap) {
                new window.OverviewMap('overview-map-container');
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMap);
        } else {
            initMap();
        }
    </script>
    <Cursor />
</body>
</html>
