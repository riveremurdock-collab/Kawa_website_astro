---
import { getCollection } from 'astro:content';
import InnerPageLayout from '../../layouts/InnerPageLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import PostsFilterTile from '../../components/PostsFilterTile.astro';

const toSlug = (id: string) => id.replace(/\/index\.mdx$/, '').replace(/\.mdx$/, '');

const publishedEntries = await getCollection('articles', ({ data }) => !data.draft);
publishedEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Already enum-consistent casing (config.ts), unlike portfolio's original
// free-text tags — no normalization needed here.
const allTags = [...new Set(publishedEntries.flatMap(e => e.data.tags))].sort();

const gridItems = publishedEntries.map(entry => ({
  href: `/articles/${toSlug(entry.id)}`,
  title: entry.data.title,
  image: entry.data.cover,
  tags: entry.data.tags,
}));
---

<InnerPageLayout
  title="Kawa Blog"
  description="Kawa Designs blog — adventure stories and route reports"
  fullScroll={true}
>
  <div class="content-width">
    <ProjectGrid
      items={gridItems}
      emptyMessage="No posts yet."
      noResultsMessage="No posts match your search."
    >
      <PostsFilterTile tags={allTags} posts={gridItems} slot="leading" />
    </ProjectGrid>
  </div>
</InnerPageLayout>
