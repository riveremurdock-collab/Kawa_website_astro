---
import InnerPageLayout from '../layouts/InnerPageLayout.astro';
import Comments from '../components/Comments.astro';
---

<InnerPageLayout title="Guest Book | Kawa Designs" description="Sign the Kawa Designs guestbook and leave your mark">
    <div class="page-content-box guestbook-box">
        <h1>Guest Book</h1>
        <p class="guestbook-intro">Leave your mark on the trail! Say hello and sign the logbook.</p>
        <div class="guestbook-wrapper">
            <Comments slug="guestbook" newestFirst formFirst />
        </div>
    </div>
</InnerPageLayout>

<style>
    .guestbook-box {
        gap: 8px;
        padding-top: 24px;
        overflow: hidden;
    }

    .guestbook-box h1 {
        margin-bottom: 0;
    }

    .guestbook-intro {
        color: #717045;
        font-size: 1.05rem;
        flex-shrink: 0;
        margin-bottom: 8px;
    }

    /* Fills remaining height in the flex column and scrolls the entries
       inside it, so the page itself stays put. */
    .guestbook-wrapper {
        background: white;
        border-radius: 16px;
        padding: 20px;
        flex: 1;
        min-height: 0;
        overflow-y: auto;
    }
</style>
