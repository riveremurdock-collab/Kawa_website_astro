---
import LandingLayout from '../layouts/LandingLayout.astro';
import Header from '../components/Header.astro';
---

<LandingLayout title="Kawa Designs" description="Kawa Designs — outdoor adventure, route maps, and design">
    <Header variant="landing" />
</LandingLayout>

<style is:global>
    .landing {
        width: 100%;
        height: 100vh;
        height: 100dvh;
        background-image: var(--landing-bg-desktop);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .landing {
            background-image: var(--landing-bg-mobile);
        }
    }

    .landing-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        padding: 40px 24px;
    }

    .landing-logo {
        max-width: 800px;
        width: 88vw;
        height: auto;
    }

    .landing-nav ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 0;
        margin: 0;
    }

    .landing-nav li {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .nav-bullet {
        width: 28px;
        height: auto;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .landing-nav li:hover .nav-bullet {
        transform: scale(1.4);
    }

    .landing-nav a {
        font-family: 'AveriaLibre', sans-serif;
        font-weight: 700;
        font-size: 1.7rem;
        letter-spacing: 3px;
        color: #1c1c1c;
        text-decoration: none;
        transition: color 0.2s ease, transform 0.15s ease;
        display: inline-block;
    }

    .landing-nav a:hover {
        color: #9b5108;
        transform: translateX(4px);
    }

    @media (max-width: 768px) {
        .landing-content {
            gap: 20px;
            padding: 24px 20px;
        }
    }

    @media (max-width: 480px) {
        .landing-content {
            gap: 14px;
            padding: 16px 20px;
        }
        .landing-logo {
            max-width: 300px;
        }
        .landing-nav ul {
            gap: 8px;
        }
        .landing-nav a {
            font-size: 1.1rem;
            letter-spacing: 2px;
        }
    }
</style>
