---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { INLINE_IMAGE_WIDTHS, INLINE_IMAGE_SIZES } from '../../lib/content-image-sizes';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** A single paragraph beside the image. For more than one, write the
   *  paragraphs as Markdown children instead — see BLOCKS.md. */
  text?: string;
}

const { src, alt, caption, text } = Astro.props;
---

<div class="photo-inline-wrapper">
    <div class="photo-inline-text">
        {text && <p>{text}</p>}
        <slot />
    </div>
    <figure class="photo-inline-figure">
        <Image
          src={src}
          alt={alt}
          loading="lazy"
          data-lightbox-group="page"
          width={INLINE_IMAGE_WIDTHS.at(-1)}
          widths={INLINE_IMAGE_WIDTHS}
          sizes={INLINE_IMAGE_SIZES}
        />
        {caption && <figcaption>{caption}</figcaption>}
    </figure>
</div>

<style>
    .photo-inline-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: start;
        margin: 2rem 0;
    }

    .photo-inline-text {
        line-height: 1.8;
    }

    /* :global because paragraphs passed as Markdown children are rendered in
       the content's scope, not this component's, so a plain descendant
       selector would never match them. Covers the `text` prop's own <p> too,
       so both ways of filling the column space the same. */
    .photo-inline-text :global(p) {
        margin-bottom: 1.1rem;
    }

    .photo-inline-text :global(p:last-child) {
        margin-bottom: 0;
    }

    .photo-inline-figure {
        margin: 0;
    }

    .photo-inline-figure img {
        display: block;
        width: auto;
        max-width: 100%;
        height: auto;
        max-height: var(--content-image-max-height);
        border-radius: 4px;
        margin-inline: auto;
        transition: transform 0.2s ease;
    }

    .photo-inline-figure img:hover {
        transform: scale(1.02);
    }

    .photo-inline-figure figcaption {
        font-family: var(--font-main);
        font-size: 11px;
        text-align: center;
        margin-top: 6px;
        color: var(--color-sage);
        padding: 4px;
    }

    @media (max-width: 700px) {
        .photo-inline-wrapper {
            grid-template-columns: 1fr;
        }
    }
</style>
