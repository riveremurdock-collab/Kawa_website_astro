---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { FULL_WIDTH_IMAGE_WIDTHS, FULL_WIDTH_IMAGE_SIZES } from '../../lib/content-image-sizes';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Hover tooltip. Not a caption — it isn't visible on the page and never
   *  reaches the lightbox. Carries over the text that Markdown image syntax
   *  put after the filename. */
  title?: string;
  /** Load immediately rather than lazily. For a hero at the top of a page;
   *  anything further down the page should stay lazy. */
  eager?: boolean;
}

const { src, alt, caption, title, eager = false } = Astro.props;

// The height cap is expressed as a max-width derived from the image's own
// proportions, so a tall photo narrows instead of being squashed to meet it.
// Nothing is ever cropped or letterboxed to fit.
const ratio = src.width / src.height;
---

<figure class="photo-figure" style={`--photo-ratio: ${ratio.toFixed(4)};`}>
  <Image
    src={src}
    alt={alt}
    title={title}
    loading={eager ? 'eager' : 'lazy'}
    data-lightbox-group="page"
    width={FULL_WIDTH_IMAGE_WIDTHS.at(-1)}
    widths={FULL_WIDTH_IMAGE_WIDTHS}
    sizes={FULL_WIDTH_IMAGE_SIZES}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo-figure {
       margin-block: calc(var(--media-gap) / 2);
    text-align: center;
  }

  .photo-figure img {
    display: block;
    width: 100%;
    max-width: calc(var(--photo-ratio) * var(--content-image-max-height));
    height: auto;
    margin-inline: auto;
    border-radius: 10px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .photo-figure img:hover {
    opacity: 0.9;
  }

  .photo-figure figcaption {
    font-family: var(--font-main);
    font-size: 11px;
    text-align: center;
    margin-top: 6px;
    color: var(--color-sage);
    padding: 4px;
  }
</style>
