---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { GALLERY_IMAGE_WIDTHS, GALLERY_IMAGE_SIZES } from '../../lib/content-image-sizes';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  title?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;

// Rows are justified: within a row every image is scaled to one shared
// height, and the row fills the media zone edge to edge. That works because
// at a common height h, an image's width is h * ratio — so giving each cell
// `flex-grow: ratio` over `flex-basis: 0` distributes the row's free width in
// exactly that proportion. Flex subtracts the gaps before distributing, so
// the widths always sum to the full zone and the heights always match.
//
// Nothing is cropped, letterboxed or distorted at any point, which is why
// orientation no longer constrains what can share a row.
function rowSizeFor(count: number): number {
  if (count <= 3) return count;
  if (count > 6) return 3;
  return count % 3 === 0 ? 3 : count % 2 === 0 ? 2 : 3;
}

const perRow = rowSizeFor(images.length);
const rows: GalleryImage[][] = [];
for (let i = 0; i < images.length; i += perRow) {
  rows.push(images.slice(i, i + perRow));
}

const ratioOf = (image: GalleryImage) => image.src.width / image.src.height;
---

{images.length > 0 && (
  <div class="gallery-grid">
    {rows.map(row => {
      // The height cap has to bind on the row, not the cell — capping cells
      // individually would break the shared height the row depends on. A row
      // of ratios summing to R is `available / R` tall, so the width at which
      // the row hits the cap is `cap * R`, plus its gaps.
      const ratioSum = row.reduce((sum, image) => sum + ratioOf(image), 0);
      return (
        <div
          class="gallery-row"
          style={`--row-ratio-sum: ${ratioSum.toFixed(4)}; --row-gaps: ${row.length - 1};`}
        >
          {row.map(image => (
            <figure class="gallery-item" style={`--cell-ratio: ${ratioOf(image).toFixed(4)};`}>
              <Image
                src={image.src}
                alt={image.alt}
                title={image.title}
                loading="lazy"
                data-lightbox-group="page"
                width={GALLERY_IMAGE_WIDTHS.at(-1)}
                widths={GALLERY_IMAGE_WIDTHS}
                sizes={GALLERY_IMAGE_SIZES}
              />
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          ))}
        </div>
      );
    })}
  </div>
)}

<style>
  /* One gap value for both axes. The rows are laid out by this column flex
     container, so the space between rows and the space between cells come
     from the same declaration and cannot drift apart. */
  .gallery-grid {
    --gallery-gap: var(--media-gap);
    display: flex;
    flex-direction: column;
    gap: var(--gallery-gap);
    /* Half the gap, so a gallery stacked against another media block adds up
       to exactly one --media-gap between them. */
    margin-block: calc(var(--media-gap) / 2);
  }

  .gallery-row {
    display: flex;
    gap: var(--gallery-gap);
    max-width: calc(
      var(--content-image-max-height) * var(--row-ratio-sum)
      + var(--gallery-gap) * var(--row-gaps)
    );
    margin-inline: auto;
    width: 100%;
  }

  /* Grow by ratio, shrink allowed, no base width — so the row's whole width
     is distributed in proportion to the ratios.

     Longhands rather than the `flex` shorthand on purpose. A var() inside a
     shorthand is substituted after parsing, so if --cell-ratio were ever
     missing or malformed the entire shorthand would fall back to its initial
     `0 1 auto` and the row would silently lose its proportions. Set
     separately, a bad ratio can only affect flex-grow. */
  .gallery-item {
    flex-grow: var(--cell-ratio);
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .gallery-item img:hover {
    opacity: 0.9;
    transform: scale(1.01);
  }

  .gallery-item figcaption {
    font-family: var(--font-main);
    font-size: 11px;
    text-align: center;
    margin-top: 6px;
    color: var(--color-sage);
    padding: 4px;
  }

  /* A justified row of three on a phone is three slivers, so rows stack.
     The cap comes off with them: each image is then bounded by the zone
     width like any single photo. */
  @media (max-width: 700px) {
    .gallery-row {
      flex-direction: column;
      max-width: 100%;
    }

    .gallery-item {
      flex-grow: 0;
      flex-shrink: 0;
      flex-basis: auto;
    }
  }
</style>
