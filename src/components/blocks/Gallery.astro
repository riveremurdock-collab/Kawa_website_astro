---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { GALLERY_IMAGE_WIDTHS, GALLERY_IMAGE_SIZES } from '../../lib/content-image-sizes';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

{images.length > 0 && (
  <div class="gallery-grid">
    {images.map(image => (
      <figure class="gallery-item">
        <Image
          src={image.src}
          alt={image.alt}
          loading="lazy"
          data-lightbox-group="page"
          width={GALLERY_IMAGE_WIDTHS.at(-1)}
          widths={GALLERY_IMAGE_WIDTHS}
          sizes={GALLERY_IMAGE_SIZES}
        />
        {image.caption && <figcaption>{image.caption}</figcaption>}
      </figure>
    ))}
  </div>
)}

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    margin: 2rem 0;
  }

  .gallery-item {
    margin: 0;
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .gallery-item img:hover {
    opacity: 0.9;
    transform: scale(1.01);
  }

  .gallery-item figcaption {
    font-family: var(--font-main);
    font-size: 11px;
    text-align: center;
    margin-top: 6px;
    color: var(--color-sage);
    padding: 4px;
  }
</style>
