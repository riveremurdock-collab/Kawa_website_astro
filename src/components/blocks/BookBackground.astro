---
// One background section of a photo book page. A page can have up to three,
// each covering one or more columns; columns without one show the blurred
// glass. Clicking a section grows it to fill the page.
//
// span  — which columns it covers: "all" (default), "left", "center",
//         "right", "left-center" or "center-right". On phones the columns
//         turn into rows: left → top, center → middle, right → bottom.
// src   — a photo in the post folder, e.g. "./IMG_3626.jpg".
// video — instead of src: a short, compressed .mp4/.webm. Plays muted, looping.
// focus — which part stays visible when cropped, as a CSS position:
//         "center" (default), "center bottom", "30% 60%"…
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveImage, resolveVideo, imageTone } from '../../lib/photobook-media';

export type Span = 'all' | 'left' | 'center' | 'right' | 'left-center' | 'center-right';

interface Props {
  span?: Span;
  src?: string | ImageMetadata;
  video?: string;
  alt?: string;
  focus?: string;
}

const { span = 'all', src, video, alt = '', focus = 'center' } = Astro.props;

const SPANS: Span[] = ['all', 'left', 'center', 'right', 'left-center', 'center-right'];
if (!SPANS.includes(span)) {
  throw new Error(`BookBackground: span="${span}" isn't one of: ${SPANS.join(', ')}.`);
}
if (!src && !video) {
  throw new Error(`BookBackground (span="${span}"): give it a src="./photo.jpg" or a video="./clip.mp4".`);
}

const resolved = src ? await resolveImage(src, Astro.url) : null;
const videoUrl = video ? await resolveVideo(video, Astro.url) : null;
// Videos are usually darker and always moving — white text is the safe call.
const tone = resolved ? await imageTone(resolved.key) : 'dark';
// Phones: text in the top-right cell, or spanning the whole top row.
const phoneTone = resolved ? await imageTone(resolved.key, 'phone-right') : 'dark';
const phoneWideTone = resolved ? await imageTone(resolved.key, 'phone-wide') : 'dark';
---

<div class="pb-bg" data-pb-bg="" data-span={span} data-tone={tone} data-tone-phone={phoneTone} data-tone-phone-wide={phoneWideTone}>
  {resolved ? (
    <Image
      src={resolved.image}
      alt={alt}
      widths={[640, 960, 1440, 1920, 2560, 3840]}
      sizes={span === 'all' ? '100vw' : span.includes('-') ? '67vw' : '34vw'}
      loading="lazy"
      draggable="false"
      style={`object-position: ${focus};`}
    />
  ) : (
    <video
      src={videoUrl}
      muted
      autoplay
      loop
      playsinline
      preload="metadata"
      aria-label={alt}
      style={`object-position: ${focus};`}
    />
  )}
</div>
