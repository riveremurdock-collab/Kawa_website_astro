---
import { Image } from 'astro:assets';
import logo from '../assets/logos/kawa lichen landing page logo.png';
import bullet from '../assets/icons/lichen bullet point.png';
import arrow from '../assets/icons/lichen arrow 2.png';

interface Props {
  variant?: 'landing' | 'inner';
}
const { variant = 'inner' } = Astro.props;
const pathname = Astro.url.pathname;

// Inner-page sitewide nav — edit these three arrays to change nav content/order.
const mainNav = [
  { href: '/blog',    label: 'KAWA BLOG' },
  { href: 'https://kawadesign.bigcartel.com', label: 'STORE', external: true },
  { href: '/contact', label: 'STAY IN TOUCH' },
];

const extrasNav = [
  { href: '/map',       label: 'MAP OVERVIEW' },
  { href: '/guestbook', label: 'GUESTBOOK' },
  { href: '/portfolio', label: 'PORTFOLIO' },
];

// Landing page gets its own flat nav — no Extras dropdown.
const landingNav = [
  { href: '/blog',      label: 'KAWA BLOG' },
  { href: 'https://kawadesign.bigcartel.com', label: 'STORE', external: true },
  { href: '/portfolio', label: 'PORTFOLIO' },
  { href: '/contact',   label: 'STAY IN TOUCH' },
];

function isCurrent(href: string): boolean {
  if (href.startsWith('http')) return false;
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---

{variant === 'landing' ? (
  <main class="landing">
    <div class="landing-content">
      <Image
        src={logo}
        alt="KAWA"
        class="landing-logo"
        fetchpriority="high"
      />
      <nav class="landing-nav site-nav">
        <ul>
          {landingNav.map(item => (
            <li>
              <Image src={bullet} alt="" class="nav-bullet" />
              <a
                href={item.href}
                class:list={[{ 'is-current': isCurrent(item.href) }]}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
) : (
  <header class="inner-topbar">
    <a href="/" class="inner-logo-link">
      <Image src={logo} alt="KAWA" class="inner-logo" />
    </a>

    <!-- Desktop nav pill -->
    <nav class="inner-nav site-nav" aria-label="Site navigation">
      <ul>
        {mainNav.map(item => (
          <li class:list={[{ 'is-current': isCurrent(item.href) }]}>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-dropdown">
          <button
            type="button"
            class="nav-dropdown-toggle"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="extras-menu"
          >
            EXTRAS<span class="nav-caret" aria-hidden="true"></span>
          </button>
        </li>
      </ul>

      <!-- The panel sits outside the pill <ul> on purpose. That <ul> has a
           backdrop-filter, which forms a backdrop root: a panel nested inside
           it would only blur against the <ul>'s own painted area, so its blur
           would render as effectively nothing and not match the pill. -->
      <ul id="extras-menu" class="nav-dropdown-menu">
        {extrasNav.map(item => (
          <li class:list={[{ 'is-current': isCurrent(item.href) }]}>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile: arrow button sits inline to the right of the logo -->
    <button class="mobile-menu-btn" aria-expanded="false" aria-controls="mobile-dropdown" aria-label="Open navigation">
      <Image src={arrow} alt="" class="menu-arrow" aria-hidden="true" />
    </button>

    <!-- Dropdown is fixed so it can be centered regardless of logo position -->
    <nav id="mobile-dropdown" class="mobile-dropdown site-nav" aria-hidden="true">
      <ul>
        {mainNav.map(item => (
          <li class:list={[{ 'is-current': isCurrent(item.href) }]}>
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="mobile-extras">
          <button
            type="button"
            class="mobile-extras-toggle"
            aria-expanded="false"
            aria-controls="mobile-extras-menu"
          >
            EXTRAS<span class="nav-caret" aria-hidden="true"></span>
          </button>
          <ul id="mobile-extras-menu" class="mobile-extras-menu">
            {extrasNav.map(item => (
              <li class:list={[{ 'is-current': isCurrent(item.href) }]}>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </li>
      </ul>
    </nav>
  </header>
)}

<style is:global>
  /* ============================================================
     INNER TOPBAR — desktop: logo left, nav pill right
     ============================================================ */
  .inner-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: nowrap;
    position: relative;
    z-index: 10;
  }

  /* Logo */
  .inner-logo-link {
    display: inline-block;
    line-height: 0;
    flex-shrink: 0;
  }

  .inner-logo {
    height: 60px;
    width: auto;
    transition: transform 0.3s ease;
  }

  .inner-logo-link:hover .inner-logo {
    transform: scale(1.06);
  }

  /* ---- Desktop nav pill ---- */
  .inner-nav {
    display: flex;
    /* Containing block for the Extras panel, so the panel's gap and right
       edge measure from the pill's real edges rather than from the button. */
    position: relative;
  }

  .inner-nav ul {
    list-style: none;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 4px;
    padding: 10px 24px;
    margin: 0;
    background: rgba(63, 63, 63, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 999px;
  }

  .inner-nav li a {
    font-family: 'AveriaLibre', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 2px;
    color: #ffffff;
    text-decoration: none;
    opacity: 1;
    transition: opacity 0.15s ease;
    display: inline-block;
    white-space: nowrap;
    padding: 2px 8px;
  }

  .inner-nav li a:hover {
    opacity: 0.7;
  }

  .inner-nav li.is-current a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Extras dropdown (desktop) ----
     The panel anchors to .inner-nav, not to this li: the li sits inside the
     pill's padding, so anchoring here would place the panel 10px above the
     pill's bottom edge and overlap it. */

  .nav-dropdown-toggle {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 2px;
    color: #ffffff;
    background: none;
    border: none;
    border-radius: 0;
    margin: 0;
    cursor: pointer;
    opacity: 1;
    transition: opacity 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    padding: 2px 8px;
  }

  .nav-dropdown-toggle:hover {
    opacity: 0.7;
  }

  .nav-dropdown-toggle:focus-visible {
    outline: 2px solid var(--color-dark-sandstone);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .nav-caret {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-top: -3px;
  }

  .nav-dropdown-toggle[aria-expanded="true"] .nav-caret,
  .mobile-extras-toggle[aria-expanded="true"] .nav-caret {
    transform: rotate(-135deg);
    margin-top: 3px;
  }

  .nav-dropdown-menu {
    list-style: none;
    position: absolute;
    top: 100%;
    right: 0;
    /* Clear 12px gap below the pill (measured from the pill's own bottom
       edge, since .inner-nav is the containing block). */
    margin: 12px 0 0;
    padding: 10px 24px;
    min-width: 200px;
    /* Same translucent dark pill material as .inner-nav ul, so the
       dropdown reads as a continuation of the pill, not a new box. */
    background: rgba(63, 63, 63, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    /* The pill's 999px is a capsule: on its ~48px height that renders as a
       ~24px corner arc. Matching that arc here reproduces the same visual
       roundness — copying 999px literally would scale down on this taller
       box and flatten it into a stadium shape. */
    border-radius: 24px;
    z-index: 200;
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-dropdown-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-dropdown-menu li + li {
    margin-top: 4px;
  }

  .nav-dropdown-menu li a {
    /* Matches .inner-nav li a exactly: same family, weight, size,
       letter-spacing, color, and padding as the main pill's links. */
    display: block;
    font-family: 'AveriaLibre', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 2px;
    color: #ffffff;
    text-decoration: none;
    opacity: 1;
    transition: opacity 0.15s ease;
    padding: 2px 8px;
    white-space: nowrap;
  }

  .nav-dropdown-menu li a:hover {
    opacity: 0.7;
  }

  .nav-dropdown-menu li a:focus-visible {
    outline: 2px solid var(--color-dark-sandstone);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .nav-dropdown-menu li.is-current a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Mobile: arrow button + centered dropdown ---- */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .mobile-menu-btn:hover {
    opacity: 0.7;
  }

  .menu-arrow {
    width: 43px;
    height: auto;
    display: block;
    /* right-pointing icon → rotated 90° clockwise = down (collapsed) */
    transform: rotate(90deg);
    transition: transform 0.25s ease;
  }

  .mobile-menu-btn[aria-expanded="true"] .menu-arrow {
    /* rotated 90° counter-clockwise = up (open) */
    transform: rotate(-90deg);
  }

  .mobile-dropdown {
    display: none;
    position: fixed;
    top: 90px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(63, 63, 63, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 16px;
    padding: 12px 0;
    min-width: 220px;
    z-index: 200;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .mobile-dropdown.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-dropdown ul {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
  }

  .mobile-dropdown li a {
    display: block;
    font-family: 'AveriaLibre', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 2px;
    color: #ffffff;
    text-decoration: none;
    padding: 10px 28px;
    transition: background 0.15s ease;
  }

  .mobile-dropdown li a:hover,
  .mobile-dropdown li.is-current a {
    background: rgba(255, 255, 255, 0.1);
  }

  .mobile-dropdown li.is-current a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Extras accordion (mobile, nested inside .mobile-dropdown) ---- */
  .mobile-extras-toggle {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    border-radius: 0;
    margin: 0;
    font-family: 'AveriaLibre', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 2px;
    color: #ffffff;
    cursor: pointer;
    padding: 10px 28px;
    transition: background 0.15s ease;
  }

  .mobile-extras-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .mobile-extras-menu {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }

  .mobile-extras-menu.is-open {
    max-height: 260px;
  }

  .mobile-extras-menu li a {
    font-size: 0.9rem;
    padding: 9px 28px 9px 40px;
  }

  /* Mobile breakpoint */
  @media (max-width: 768px) {
    .inner-topbar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: nowrap;
    }

    .inner-logo {
      height: 50px;
    }

    .inner-nav {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-dropdown {
      display: block;
    }
  }

  /* ============================================================
     LANDING NAV (unchanged)
     ============================================================ */
  .landing-nav a.is-current {
    color: var(--color-dark-sandstone);
  }
</style>

<script is:inline>
  (function () {
    /* ---- WebAudio hover/click blips ---- */
    let ctx = null;

    function getCtx() {
      if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();
      return ctx;
    }

    function playHover() {
      try {
        const ac = getCtx();
        const osc = ac.createOscillator();
        const gain = ac.createGain();
        osc.connect(gain);
        gain.connect(ac.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, ac.currentTime);
        osc.frequency.exponentialRampToValueAtTime(660, ac.currentTime + 0.08);
        gain.gain.setValueAtTime(0.12, ac.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + 0.1);
        osc.start(ac.currentTime);
        osc.stop(ac.currentTime + 0.1);
      } catch (e) {}
    }

    function playClick() {
      try {
        const ac = getCtx();
        const osc = ac.createOscillator();
        const gain = ac.createGain();
        osc.connect(gain);
        gain.connect(ac.destination);
        osc.type = 'sine';
        osc.frequency.setValueAtTime(400, ac.currentTime);
        osc.frequency.exponentialRampToValueAtTime(80, ac.currentTime + 0.12);
        gain.gain.setValueAtTime(0.25, ac.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + 0.15);
        osc.start(ac.currentTime);
        osc.stop(ac.currentTime + 0.15);
      } catch (e) {}
    }

    document.addEventListener('DOMContentLoaded', function () {
      /* Nav sound on all .site-nav items (links + the Extras toggle buttons) */
      document.querySelectorAll('.site-nav li').forEach(function (li) {
        li.addEventListener('mouseenter', playHover);
        var link = li.querySelector('a, button');
        if (link) link.addEventListener('click', playClick);
      });

      /* ---- Generic open/close disclosure used by both the desktop
         Extras dropdown and the mobile Extras accordion ---- */
      function setupDisclosure(toggle, menu) {
        if (!toggle || !menu) return null;

        function isOpen() {
          return toggle.getAttribute('aria-expanded') === 'true';
        }

        function open() {
          toggle.setAttribute('aria-expanded', 'true');
          menu.classList.add('is-open');
        }

        function close(focusToggle) {
          toggle.setAttribute('aria-expanded', 'false');
          menu.classList.remove('is-open');
          if (focusToggle) toggle.focus();
        }

        toggle.addEventListener('click', function (e) {
          e.stopPropagation();
          if (isOpen()) {
            close(false);
          } else {
            open();
          }
        });

        toggle.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (!isOpen()) open();
            var first = menu.querySelector('a');
            if (first) first.focus();
          } else if (e.key === 'Escape' && isOpen()) {
            close(true);
          }
        });

        menu.addEventListener('keydown', function (e) {
          var items = Array.from(menu.querySelectorAll('a'));
          var idx = items.indexOf(document.activeElement);
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            var next = items[(idx + 1) % items.length];
            if (next) next.focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            var prev = items[(idx - 1 + items.length) % items.length];
            if (prev) prev.focus();
          } else if (e.key === 'Home') {
            e.preventDefault();
            if (items[0]) items[0].focus();
          } else if (e.key === 'End') {
            e.preventDefault();
            if (items[items.length - 1]) items[items.length - 1].focus();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            close(true);
          }
        });

        menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () { close(false); });
        });

        /* Checked against toggle and menu directly rather than a shared
           ancestor, since on desktop the menu is not a descendant of the
           toggle's li (see the markup comment about backdrop roots). */
        function handleFocusOut(e) {
          var to = e.relatedTarget;
          if (to && (toggle.contains(to) || menu.contains(to))) return;
          close(false);
        }
        toggle.addEventListener('focusout', handleFocusOut);
        menu.addEventListener('focusout', handleFocusOut);

        return { open: open, close: close, isOpen: isOpen };
      }

      var desktopExtras = setupDisclosure(
        document.querySelector('.nav-dropdown-toggle'),
        document.querySelector('.nav-dropdown-menu')
      );
      var mobileExtras = setupDisclosure(
        document.querySelector('.mobile-extras-toggle'),
        document.querySelector('.mobile-extras-menu')
      );

      /* Close the desktop dropdown on outside click/tap */
      document.addEventListener('click', function (e) {
        if (
          desktopExtras &&
          desktopExtras.isOpen() &&
          !e.target.closest('.nav-dropdown') &&
          !e.target.closest('.nav-dropdown-menu')
        ) {
          desktopExtras.close(false);
        }
      });

      /* Mobile dropdown toggle */
      var btn = document.querySelector('.mobile-menu-btn');
      var dropdown = document.getElementById('mobile-dropdown');
      if (!btn || !dropdown) return;

      function closeMenu() {
        btn.setAttribute('aria-expanded', 'false');
        dropdown.setAttribute('aria-hidden', 'true');
        dropdown.classList.remove('is-open');
        if (mobileExtras) mobileExtras.close(false);
      }

      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = btn.getAttribute('aria-expanded') === 'true';
        if (open) {
          closeMenu();
        } else {
          btn.setAttribute('aria-expanded', 'true');
          dropdown.setAttribute('aria-hidden', 'false');
          dropdown.classList.add('is-open');
        }
      });

      /* Close on outside tap */
      document.addEventListener('click', function (e) {
        if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
          closeMenu();
        }
      });

      /* Close the whole mobile menu (including the Extras accordion)
         whenever any link inside it — top-level or nested — is tapped */
      dropdown.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', closeMenu);
      });
    });
  })();
</script>
