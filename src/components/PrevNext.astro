---
interface ProjectLink {
  slug: string;
  title: string;
}

interface Props {
  prev: ProjectLink | null;
  next: ProjectLink | null;
  // e.g. "/portfolio" or "/articles" — prefix for the prev/next links.
  basePath: string;
  // e.g. "/portfolio" or "/blog" — "Return to grid" destination. Kept
  // separate from basePath rather than derived from it: portfolio's index
  // and detail pages share one segment, blog's don't (/blog vs /articles).
  gridHref: string;
}

const { prev, next, basePath, gridHref } = Astro.props;
---

<nav class="prevnext" aria-label="Page navigation">
  <div class="prevnext-prev">
    {prev ? (
      <a href={`${basePath}/${prev.slug}`} class="prevnext-link">
        <span class="prevnext-arrow">←</span>
        <span class="prevnext-label">Previous</span>
        <span class="prevnext-title">{prev.title}</span>
      </a>
    ) : <span />}
  </div>

  <a href={gridHref} class="prevnext-grid-link">
    Return to grid
  </a>

  <div class="prevnext-next">
    {next ? (
      <a href={`${basePath}/${next.slug}`} class="prevnext-link prevnext-link--right">
        <span class="prevnext-arrow">→</span>
        <span class="prevnext-label">Next</span>
        <span class="prevnext-title">{next.title}</span>
      </a>
    ) : <span />}
  </div>
</nav>

<style>
  .prevnext {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 40px;
    margin-top: 40px;
    border-top: 1px solid rgba(113, 112, 69, 0.2);
  }

  .prevnext-prev,
  .prevnext-next {
    flex: 1;
  }

  .prevnext-next {
    text-align: right;
  }

  .prevnext-link {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    color: var(--color-dark-sandstone);
    transition: color 0.2s ease;
    max-width: 200px;
  }

  .prevnext-link--right {
    align-items: flex-end;
  }

  .prevnext-link:hover {
    color: var(--color-orange);
  }

  .prevnext-arrow {
    font-size: 1.4rem;
    line-height: 1;
  }

  .prevnext-label {
    font-family: var(--font-main);
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-olive);
  }

  .prevnext-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 1px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .prevnext-grid-link {
    flex-shrink: 0;
    font-family: var(--font-main);
    font-size: 0.85rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-olive);
    text-decoration: none;
    border: 1px solid var(--color-olive);
    padding: 8px 16px;
    border-radius: 20px;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
  }

  .prevnext-grid-link:hover {
    color: var(--color-dark-sandstone);
    border-color: var(--color-dark-sandstone);
    background: rgba(155, 81, 8, 0.06);
  }

  @media (max-width: 600px) {
    .prevnext {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }

    .prevnext-next {
      text-align: left;
    }

    .prevnext-link--right {
      align-items: flex-start;
    }

    .prevnext-grid-link {
      text-align: center;
    }
  }
</style>
