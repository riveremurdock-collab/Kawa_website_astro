---
import { getImage } from 'astro:assets';
import Cursor from '../components/Cursor.astro';
import sandstoneRaw from '../assets/backgrounds/landing page sandstone background.png';
import sandstoneMobileRaw from '../assets/backgrounds/landing page sandstone background mobille.jpg';

interface Props {
    title?: string;
    description?: string;
}
const { title = "Kawa Designs", description = "Kawa Designs — outdoor adventure blog and design" } = Astro.props;

const desktopBg = await getImage({ src: sandstoneRaw, format: 'webp', width: 2400 });
const mobileBg  = await getImage({ src: sandstoneMobileRaw, format: 'webp', width: 1200 });
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/logos/kawa favicon.png" />
    <style define:vars={{ bgDesktop: `url(${desktopBg.src})`, bgMobile: `url(${mobileBg.src})` }}>
        /* Bridge optimized URLs onto :root so is:global CSS can reference them */
        :root {
            --landing-bg-desktop: var(--bgDesktop);
            --landing-bg-mobile: var(--bgMobile);
        }
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; height: 100%; overflow: hidden; }
        img { max-width: 100%; height: auto; }
        a { text-decoration: none; }
    </style>
    <style>
        @font-face {
            font-family: 'AveriaLibre';
            src: url('/fonts/Averia_Libre/AveriaLibre-Regular.ttf') format('truetype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }
        @font-face {
            font-family: 'AveriaLibre';
            src: url('/fonts/Averia_Libre/AveriaLibre-Bold.ttf') format('truetype');
            font-weight: 700;
            font-style: normal;
            font-display: swap;
        }
    </style>
</head>
<body>
    <slot />
    <Cursor />
</body>
</html>
